{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "baseUrl": "src",
        "outDir": "dist",
        "rootDir": "src",
        "sourceMap": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
    },
    "include": [
        "src/**/*"
    ],
}