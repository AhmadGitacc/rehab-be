# ── Existing ────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/rehab-me
SECRET=<existing password-hash secret>
NODE_ENV=development

# ── Auth / email (new) ──────────────────────────────────────────────────────
# Gmail SMTP with a Google App Password (account must have 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
# 16-character App Password; spaces are stripped automatically.
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Must match SMTP_USER or a verified "Send mail as" alias in Gmail.
EMAIL_FROM=your-account@gmail.com
# Public frontend origin — reset links are built from this, NEVER the Host header.
FRONTEND_URL=http://localhost:5173
# Optional extra CORS origins (comma-separated). FRONTEND_URL is always allowed.
# CORS_ORIGINS=https://rehab-fe.vercel.app,https://admin.example.com
# 32+ random bytes, base64url or hex: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=rehab-me
JWT_AUDIENCE=rehab-me-web
# Optional: only set for cross-subdomain cookies. Leave unset for host-only cookies.
# COOKIE_DOMAIN=.yourdomain.com
# Temporary legacy session fallback; remove after one stable release.
ALLOW_LEGACY_SESSION=true
